# Required secrets. Generate unique values in the deployment secret manager.
DATABASE_PASSWORD=
VALKEY_PASSWORD=
QR_SIGNING_SECRET=
DEVICE_CREDENTIAL_MASTER_KEY_BASE64=
AUTH_JWT_SECRET_BASE64=

# Required production endpoints and identity configuration.
DATABASE_URL=
DATABASE_USER=
NATS_URL=
VALKEY_HOST=
VALKEY_PORT=6379
VALKEY_TLS_ENABLED=true
APP_JWT_ISSUER=
OIDC_ISSUER_URI=
API_JWT_AUDIENCE=smart-charging-api
ALLOWED_ORIGINS=

# Enable only after real WeChat credentials are available.
WECHAT_IDENTITY_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TENANT_CODE=
WECHAT_NOTIFICATION_ENABLED=false
WECHAT_NOTIFICATION_TEMPLATES_JSON={}

# Payment material is required only for an activated merchant channel.
WECHAT_PRIMARY_PRIVATE_KEY_PATH=
WECHAT_PRIMARY_MERCHANT_SERIAL=
WECHAT_PRIMARY_API_V3_KEY=
WECHAT_PRIMARY_PUBLIC_KEY_PATH=
WECHAT_PRIMARY_PUBLIC_KEY_ID=

# Real device gateway TLS material.
DEVICE_TLS_ENABLED=true
DEVICE_TLS_CERTIFICATE=
DEVICE_TLS_PRIVATE_KEY=
DEVICE_TLS_TRUST_CERTIFICATES=

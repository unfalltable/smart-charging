# Smart Charging deployment environment template.
# Run .\config-manager.cmd init to create the private .env with random internal secrets,
# then edit .env directly. Never commit .env or place real secrets in this template.

# Core secrets (generated automatically by config-manager init when blank)
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
QR_SIGNING_SECRET=
DEVICE_CREDENTIAL_MASTER_KEY_BASE64=
AUTH_JWT_SECRET_BASE64=

# Built-in administrator login and token validation
APP_JWT_ISSUER=http://127.0.0.1:8088
API_JWT_AUDIENCE=smart-charging-api
ALLOWED_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
IDENTITY_LOGIN_EVENT_RETENTION_DAYS=180
IDENTITY_EXPIRED_TOKEN_RETENTION_DAYS=7

# The single platform super-administrator (generated when blank)
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_DISPLAY_NAME=Platform Administrator
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_SUBJECT=
PLATFORM_ADMIN_PASSWORD=

# WeChat mini-program identity and notifications
WECHAT_IDENTITY_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TENANT_CODE=
MINIAPP_DEVTOOLS_CLI_PATH=
WECHAT_NOTIFICATION_ENABLED=false
WECHAT_NOTIFICATION_TEMPLATES_JSON={}

# WeChat Pay. Private/public PEM files belong in WECHAT_PAYMENT_DIRECTORY.
WECHAT_PAYMENT_ENABLED=false
WECHAT_PAYMENT_DIRECTORY=runtime-secrets/wechat-pay
WECHAT_PRIMARY_MERCHANT_SERIAL=
WECHAT_PRIMARY_API_V3_KEY=
WECHAT_PRIMARY_PUBLIC_KEY_ID=
PAYMENT_PROFIT_SHARING_MAX_BASIS_POINTS=3000

# Real device gateway. DEVICE_TLS_DIRECTORY must contain tls.crt, tls.key and ca.crt.
DEVICE_GATEWAY_ENABLED=false
DEVICE_GATEWAY_BIND_ADDRESS=127.0.0.1
DEVICE_TLS_DIRECTORY=

# Mini-program profiles. API addresses must be HTTPS and end in /api/v1.
MINIAPP_DEVELOP_API_BASE=
MINIAPP_DEVELOP_TENANT_CODE=
MINIAPP_DEVELOP_NOTIFICATION_TEMPLATE_IDS=[]
MINIAPP_TRIAL_API_BASE=
MINIAPP_TRIAL_TENANT_CODE=
MINIAPP_TRIAL_NOTIFICATION_TEMPLATE_IDS=[]
MINIAPP_RELEASE_API_BASE=
MINIAPP_RELEASE_TENANT_CODE=
MINIAPP_RELEASE_NOTIFICATION_TEMPLATE_IDS=[]

# Local published ports
ADMIN_WEB_PORT=8088
CORE_PORT=18080
DEVICE_GATEWAY_PORT=9000
DEVICE_MANAGEMENT_PORT=9001
POSTGRES_PORT=15432
VALKEY_PORT=16379
NATS_PORT=14222
NATS_MONITOR_PORT=18222

# Runtime tuning
DATABASE_POOL_SIZE=10
DATABASE_POOL_MIN_IDLE=2
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_PUBLIC_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=20
TRACING_SAMPLE_RATE=0.1
OUTBOX_PUBLISHER_DELAY_MS=500
APPLICATION_LOG_LEVEL=INFO

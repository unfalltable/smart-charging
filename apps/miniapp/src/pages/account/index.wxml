<view class="page">
  <view class="card profile">
    <view class="avatar" aria-hidden="true"><view class="avatar-mark"></view></view>
    <text class="name">{{loggedIn ? '微信用户' : '尚未登录'}}</text>
    <text class="hint">{{loggedIn ? '账号已安全连接到微信身份' : '登录后可充电并查看订单、支付和发票'}}</text>
    <button wx:if="{{!loggedIn}}" class="primary login" loading="{{loggingIn}}" disabled="{{loggingIn}}" hover-class="button-pressed" bindtap="login">微信快捷登录</button>
  </view>
  <view class="card menu">
    <button hover-class="menu-pressed" bindtap="openWallet"><text>余额与支付记录</text><text class="chevron">›</text></button>
    <button hover-class="menu-pressed" bindtap="openInvoices"><text>发票管理</text><text class="chevron">›</text></button>
    <button hover-class="menu-pressed" bindtap="openAgreements"><text>服务协议与隐私政策</text><text class="chevron">›</text></button>
    <button hover-class="menu-pressed" bindtap="openSupport"><text>客服与故障上报</text><text class="chevron">›</text></button>
  </view>
  <button wx:if="{{loggedIn}}" class="logout" disabled="{{accountBusy}}" hover-class="button-pressed" bindtap="logout">退出登录</button>
  <button wx:if="{{loggedIn}}" class="close-account" disabled="{{accountBusy}}" hover-class="button-pressed" bindtap="closeAccount">注销消费者账号</button>
</view>

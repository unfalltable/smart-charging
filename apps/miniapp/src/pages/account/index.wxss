.profile { padding:50rpx 34rpx 34rpx;text-align:center; }
.avatar { margin:auto;width:120rpx;height:120rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#dff6ef; }
.avatar-mark { width:28rpx;height:56rpx;background:#087d69;clip-path:polygon(52% 0,100% 0,67% 40%,100% 40%,24% 100%,40% 55%,0 55%); }
.name,.hint { display:block; }
.name { margin-top:20rpx;font-size:34rpx;font-weight:800; }
.hint { margin:10rpx 0 30rpx;color:#657570;font-size:24rpx;line-height:1.6; }
.login { height:92rpx;line-height:92rpx; }
.menu { margin-top:24rpx;padding:0 30rpx; }
.menu button { width:100%;height:100rpx;margin:0;padding:0;display:flex;justify-content:space-between;align-items:center;background:transparent;border-radius:0;border-bottom:1rpx solid #edf1f0;font-size:28rpx;text-align:left; }
.menu button:last-child { border-bottom:0; }
.menu-pressed { background:#f4f8f7!important; }
.chevron { color:#64766f;font-size:38rpx; }
.logout { margin-top:30rpx;background:#fff;color:#973c3c;border:2rpx solid #d7a7a7;border-radius:16rpx;font-size:26rpx; }
.close-account { margin-top:18rpx;background:transparent;color:#697873;font-size:25rpx; }

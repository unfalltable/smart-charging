.profile { padding:50rpx 34rpx 34rpx;text-align:center; }.avatar { margin:auto;width:120rpx;height:120rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#dff6ef;font-size:54rpx; }.name,.hint { display:block; }.name { margin-top:20rpx;font-size:34rpx;font-weight:800; }.hint { margin:10rpx 0 30rpx;color:#87948f;font-size:23rpx; }.login { height:84rpx;line-height:84rpx; }.menu { margin-top:24rpx;padding:0 30rpx; }.menu view { display:flex;justify-content:space-between;padding:30rpx 0;border-bottom:1rpx solid #edf1f0;font-size:27rpx; }.menu view:last-child { border:0; }.menu text { color:#9aa5a1; }
.logout { margin-top:30rpx;background:#fff;color:#a14b4b;border:1rpx solid #e5caca;border-radius:999rpx;font-size:26rpx; }

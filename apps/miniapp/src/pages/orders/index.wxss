.order { margin-bottom:22rpx;padding:30rpx; }
.head,.numbers { display:flex;justify-content:space-between;gap:20rpx; }
.head { font-size:29rpx;font-weight:700; }
.status { color:#087d69;font-size:24rpx;flex-shrink:0; }
.meta { display:block;color:#687873;font-size:23rpx;margin:14rpx 0 32rpx;word-break:break-all; }
.numbers { align-items:flex-end;color:#596b65; }
.amount { font-size:34rpx;color:#17231f;font-weight:700; }
.stop { margin-top:28rpx;border:2rpx solid #bb4949;color:#9d3434;background:#fff;border-radius:16rpx;font-size:26rpx; }
.paid { display:block;text-align:right;color:#60716b;font-size:23rpx;margin-top:10rpx; }
.pay { margin-top:24rpx; }

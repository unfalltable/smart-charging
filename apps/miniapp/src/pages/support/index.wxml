<view class="page"><form class="card form" bindsubmit="submit"><text class="title">故障报修或意见反馈</text><input name="title" placeholder="问题标题" required/><textarea name="description" placeholder="请说明设备、端口和问题现象" maxlength="1000" required></textarea><button class="primary" form-type="submit">提交工单</button></form><view class="section-title">我的工单</view><view wx:for="{{tickets}}" wx:key="id" class="card ticket"><view><text>{{item.ticketNo}}</text><text class="status">{{item.status}}</text></view><strong>{{item.title}}</strong><text>{{item.description}}</text></view></view>

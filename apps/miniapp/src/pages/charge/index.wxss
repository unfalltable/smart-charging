.detail { padding:40rpx 34rpx; }
.station,.port { display:block; }
.station { color:#5f706b;font-size:25rpx; }
.port { font-size:44rpx;font-weight:800;margin:12rpx 0 36rpx; }
.row { display:flex;justify-content:space-between;gap:30rpx;padding:25rpx 0;border-top:1rpx solid #edf1f0;font-size:27rpx; }
.row text:first-child { color:#687a74;flex-shrink:0; }
.row text:last-child { text-align:right;word-break:break-all; }
.ok { color:#087d69;font-weight:700; }
.safety { background:#fff8e8;color:#765613;border-radius:16rpx;padding:22rpx;margin:28rpx 0;font-size:24rpx;line-height:1.6; }
.start { height:96rpx;line-height:96rpx; }

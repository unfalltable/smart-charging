.home { padding-top: 56rpx; }
.hero { background: linear-gradient(145deg, #0b6c5c, #10a486); border-radius: 32rpx; padding: 48rpx 36rpx 38rpx; color: #fff; overflow: hidden; }
.eyebrow,.title,.subtitle { display: block; }.eyebrow { font-size: 20rpx; opacity: .65; letter-spacing: 4rpx; }.title { margin-top: 16rpx; font-size: 50rpx; font-weight: 800; }.subtitle { margin-top: 12rpx; font-size: 25rpx; opacity: .8; }
.energy { height: 240rpx; display: flex; align-items: center; justify-content: center; }.bolt { width: 150rpx; height: 150rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 70rpx; background: rgba(255,255,255,.14); box-shadow: 0 0 0 28rpx rgba(255,255,255,.05); }
.scan { height: 94rpx; line-height: 94rpx; background: #fff; color: #08715e; font-size: 30rpx; }.steps { margin-top: 26rpx; padding: 32rpx 24rpx; display: flex; justify-content: space-around; }.steps view { display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 24rpx; color: #52635f; }.number { color: #0f8f78; font-size: 30rpx; font-weight: 700; }.notice { margin: 28rpx 18rpx; color: #83908d; font-size: 23rpx; line-height: 1.7; }

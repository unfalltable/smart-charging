.balance{padding:40rpx;border-radius:24rpx;background:linear-gradient(145deg,#08745f,#0b9678);color:#fff}
.balance-label,.balance-value,.balance-status{display:block}
.balance-value{font-size:58rpx;margin:18rpx 0;font-weight:700}
.balance-status{opacity:.86;font-size:24rpx}
.payment{margin-bottom:18rpx;padding:26rpx}
.payment view{display:flex;justify-content:space-between;gap:24rpx;margin:8rpx 0}
.payment .status{color:#087d69;flex-shrink:0}
.order-no{word-break:break-all}
.payment-amount{font-weight:700}
.compact{margin-top:0;padding:40rpx}
